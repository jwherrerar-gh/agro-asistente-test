APP_NAME=agro-asistente
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
# Render inyecta PORT. Si no existe, el arranque de producción usa 8000.
# Producción: python -m app.main  (0.0.0.0, sin --reload)
# Desarrollo local: uvicorn app.main:app --reload --host 127.0.0.1 --port 8000
PORT=8000

# TiDB Cloud (MySQL-compatible, TLS obligatorio en conexiones públicas).
# Reemplaza por tus valores reales en el entorno del despliegue.
MYSQL_HOST=gateway01.sa-east-1.prod.aws.tidbcloud.com
MYSQL_PORT=4000
MYSQL_USER=2R8zUK7M3rmWZLm.root
MYSQL_PASSWORD=2IRs1wjHtGnseqh5
MYSQL_DATABASE=agro_asistente
MYSQL_SSL_VERIFY_CERT=true
MYSQL_SSL_VERIFY_IDENTITY=true
MYSQL_SSL_CA_PATH=..\test\agro-asistente\database\isrgrootx1.pem
# Caracteres especiales en MYSQL_PASSWORD se codifican en la URL; no se imprime el valor.

JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120

KNOWLEDGE_DIR=../knowledge

CHROMA_PERSIST_DIR=./chroma_data
CHROMA_COLLECTION=agro_knowledge_pmv1

VECTOR_STORE_PROVIDER=qdrant
QDRANT_URL=https://your-qdrant-url
QDRANT_API_KEY=replace-with-qdrant-api-key
QDRANT_COLLECTION=agro_knowledge_pmv1
QDRANT_TIMEOUT_SECONDS=30

RAG_TOP_K=3
RAG_MIN_SIMILARITY=0.12
CHUNK_SIZE=500

EMBEDDING_PROVIDER=local
EMBEDDING_DIMENSION=128
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# PMV1: RAG + Ollama + Qwen2.5 (sin fine-tuning).
GENERATION_PROVIDER=gemini
GEMINI_API_KEY=replace-with-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=90

# Desarrollo local: usa Ollama si prefieres conservar la ejecución local del modelo.
# GENERATION_PROVIDER=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5:1.5b
# OLLAMA_TIMEOUT_SECONDS=90

SENAMHI_WIS2_BASE_URL=https://wis.senamhi.gob.pe/oapi
SENAMHI_WIS2_COLLECTION=urn:wmo:md:pe-senamhi:synop-hourly
SENAMHI_WIS2_TIMEOUT_SECONDS=20

# Orígenes del navegador, separados por comas. No uses * si las peticiones llevan credenciales.
# Local: http://localhost:5173
# En Render, añade la URL https del sitio estático, sin comodines.
CORS_ORIGINS=http://localhost:5173

# Clasificador experimental HU-07. No forma parte del flujo RAG.
CLASIFICADOR_MARGEN_MINIMO=0.17
