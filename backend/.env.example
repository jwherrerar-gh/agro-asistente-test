APP_NAME=agro-asistente
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
# Render inyecta PORT. Si no existe, el arranque de producción usa 8000.
# Producción: python -m app.main  (0.0.0.0, sin --reload)
# Desarrollo local: uvicorn app.main:app --reload --host 127.0.0.1 --port 8000
PORT=8000

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=agro_asistente
# Caracteres especiales en MYSQL_PASSWORD se codifican en la URL; no se imprime el valor.

JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120

KNOWLEDGE_DIR=../knowledge

CHROMA_PERSIST_DIR=./chroma_data
CHROMA_COLLECTION=agro_knowledge_pmv1

RAG_TOP_K=3
RAG_MIN_SIMILARITY=0.12
CHUNK_SIZE=500

EMBEDDING_PROVIDER=local
EMBEDDING_DIMENSION=128
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# PMV1: RAG + Ollama + Qwen2.5 (sin fine-tuning).
# El documento del curso cita "Qwen2.5 1.8B". Ollama no publica el tag qwen2.5:1.8b;
# la variante oficial más cercana de Qwen2.5 es qwen2.5:1.5b.
# Instalar: ollama pull qwen2.5:1.5b
GENERATION_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_TIMEOUT_SECONDS=90
# Pruebas de integración reales (pytest las omite si no está en true/1):
# RUN_OLLAMA_INTEGRATION_TESTS=true

# SENAMHI WIS 2.0 (OGC API, lectura GET sin API key).
SENAMHI_WIS2_BASE_URL=https://wis.senamhi.gob.pe/oapi
SENAMHI_WIS2_COLLECTION=urn:wmo:md:pe-senamhi:synop-hourly
SENAMHI_WIS2_TIMEOUT_SECONDS=20

# Juez RAGAS (evaluación, no es el API de negocio). Por defecto reutiliza Ollama.
# RAGAS_LLM_PROVIDER=ollama
# RAGAS_EMBEDDING_MODEL=
# OPENAI_API_KEY=

# Orígenes del navegador, separados por comas. No uses * si las peticiones llevan credenciales.
# Local: http://localhost:5173
# En Render, añade la URL https del sitio estático, sin comodines.
CORS_ORIGINS=http://localhost:5173

# Clasificador experimental HU-07. No forma parte del flujo RAG.
# El predeterminado 0.17 es el margen de la versión v2. Un valor inválido detiene el arranque.
CLASIFICADOR_MARGEN_MINIMO=0.17
# Ruta relativa a la raíz del proyecto. Vacío usa el modelo v2 del repositorio.
# CLASIFICADOR_MODELO_RUTA=backend/clasificacion/experimentos/hu07_tfidf_v2/modelo_tfidf_logreg_v2.joblib
